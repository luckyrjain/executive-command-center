# Network resilience for pnpm's registry requests -- `pnpm install` and, via
# the same fetch options, `pnpm audit` (ci.yml's `frontend` job). pnpm's
# defaults are fetch-retries=2 (waits of 10s then 60s) and fetch-timeout=60s;
# on 2026-09-04 registry.npmjs.org's audit endpoint timed out through all
# three attempts on 5 of 8 CI runs. Five retries with the same 10s..60s
# exponential back-off gives roughly 5 minutes of retry window per request
# instead of ~1. Does not change what is fetched or from where.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=60000
